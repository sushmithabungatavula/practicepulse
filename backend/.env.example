# SQLite is used by default (zero setup). To use Postgres, set:
# DATABASE_URL=postgresql://user:password@localhost:5432/practicepulse
DATABASE_URL=sqlite:///./practicepulse.db

SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# First admin account, created automatically on startup if it doesn't exist
ADMIN_EMAIL=admin@practicepulse.app
ADMIN_PASSWORD=changeme123

# Used to build public profile / QR code URLs, e.g. http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173
